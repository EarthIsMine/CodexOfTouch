# Sepolia Testnet RPC (Infura, Alchemy, etc.)
# Get one from: https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private Key (WITHOUT 0x prefix)
# IMPORTANT: This is the deployer account that will own the contract
# Make sure it has some Sepolia ETH for gas (get from https://sepoliafaucet.com)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Etherscan API Key (for contract verification)
# Get one from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: Mainnet RPC (for future production deployment)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
